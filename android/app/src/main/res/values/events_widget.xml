<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="events_widget_description">Mayor, election, Bingo and fire sales</string>

    <style name="EventsWidgetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#EDEDED</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EventsWidgetDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#A0A0A0</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
