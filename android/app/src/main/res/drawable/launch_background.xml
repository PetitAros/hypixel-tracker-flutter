<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Flutter draws: the app icon on the icon's dark
     background. From Android 12 the system splash (values-v31) is used. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#141417" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
